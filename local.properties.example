# Copy this file to local.properties and set sdk.dir for your machine.
sdk.dir=/path/to/Android/sdk

# Set all four inputs locally or through CI to sign release artifacts with the
# upload key registered for com.veilgate.vpn in Google Play Console.
# Without these inputs the release APK and AAB are unsigned.
# RAVEN_UPLOAD_STORE_FILE=/absolute/path/to/upload.jks
# RAVEN_UPLOAD_STORE_PASSWORD=
# RAVEN_UPLOAD_KEY_ALIAS=
# RAVEN_UPLOAD_KEY_PASSWORD=
